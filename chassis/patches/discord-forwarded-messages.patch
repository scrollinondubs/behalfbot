+// behalfbot-patch: discord-forwarded-messages
+// A forwarded message arrives as an empty shell: its own content and
+// attachments are empty, and the original text and files live in
+// msg.messageSnapshots (discord.js >= 14.17). Read the snapshots so forwards
+// are not delivered blank. Drop this patch once upstream reads them itself.
+function isForward(msg: Message): boolean {
+  return (msg.messageSnapshots?.size ?? 0) > 0
+}
+
+function forwardedContent(msg: Message): string {
+  const parts: string[] = []
+  for (const snap of msg.messageSnapshots?.values() ?? []) {
+    if (snap.content) parts.push(snap.content)
+  }
+  return parts.join('\n')
+}
+
+function allAttachments(msg: Message): Attachment[] {
+  const out: Attachment[] = [...msg.attachments.values()]
+  for (const snap of msg.messageSnapshots?.values() ?? []) {
+    if (snap.attachments) out.push(...snap.attachments.values())
+  }
+  return out
 }
 
