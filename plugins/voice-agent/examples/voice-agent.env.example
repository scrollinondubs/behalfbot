# Voice agent environment.
#
# Hydrated from the openclaw.plugin.json configSchema at install time; this file
# is the shape it produces, and a hand-written one works exactly as well.
# Everything here has a default in the code, so an install only sets what it
# wants to change. Copy to data/voice-agent.env.

# --- identity ---------------------------------------------------------------

# What you call the agent out loud.
VOICE_AGENT_NAME=Jax

# What speech recognition WRITES instead of that name. This is the field people
# skip and then wonder why the agent never notices being addressed. whisper-base
# renders "Jax" as "Jack" or "Jacks" most of the time. Read your own transcripts
# and put what you actually see here.
VOICE_AGENT_NAME_VARIANTS=jax,jacks,jaxx,jack,jags,jx

# Who the agent works for. Used in the classifier prompt so it can tell "is this
# about something of theirs" from "is this general knowledge".
VOICE_OPERATOR_NAME=Sean

# The nouns a 4B model can match on. Projects, products, repos, the tools you
# live in. Vague descriptions of a business do not help it; names do.
VOICE_OPERATOR_PROJECTS=Vibecode Lisboa, MicroAdventures, prep.training, notes in SiYuan, the dating queue, Oura sleep numbers

# Optional. A second, private brain you keep off this machine entirely. Naming
# it out loud does not route anywhere - there is no such destination - it HOLDS
# the turn and tells you to take it there yourself. Leave both empty if you do
# not have one.
VOICE_PRIVATE_BRAIN_NAME=Jill
VOICE_PRIVATE_BRAIN_NAME_VARIANTS=jill,jil,jils,jyl,jell,gil,gill,jail,jails

# --- data files -------------------------------------------------------------

# Speech-recognition repairs. See examples/aliases.example.json.
VOICE_ALIASES_PATH=${CHASSIS_HOME}/plugins/voice-agent/data/aliases.json

# What gets refused outright. NOTHING SHIPS BY DEFAULT - see
# examples/sensitive-terms.example.json and write your own. An install with no
# file simply has no keyword net, which is a coherent choice.
VOICE_SENSITIVE_TERMS_PATH=${CHASSIS_HOME}/plugins/voice-agent/data/sensitive-terms.json

# --- models -----------------------------------------------------------------

VOICE_ROUTER_MODEL=gemma3:4b
VOICE_LLM_MODEL=llama3.2:3b
VOICE_TTS_VOICE=af_heart

# whisper-base is fast and fine for English commands. For any language where a
# misheard word changes the meaning, use mlx-community/whisper-large-v3-turbo.
# Measured on European Portuguese: base heard "com o prazo", turbo heard "como
# prazo" - "with the deadline" versus "as the deadline".
VOICE_STT_MODEL=mlx-community/whisper-base-mlx
# ISO code, or leave empty to auto-detect. Pin it if you speak one language;
# leave it empty for a mixed-language conversation.
VOICE_STT_LANGUAGE=

# Second classifier voter. Off since the router dropped to two destinations -
# it existed to union two models' privacy verdicts and there is no privacy
# verdict left to union.
VOICE_ROUTER_MODEL_2=off

# --- escalation -------------------------------------------------------------

VOICE_JAX_MODEL=sonnet
# A question that queries a database costs about $0.35. Too tight a ceiling
# fails the turn rather than saving money.
VOICE_JAX_BUDGET_USD=1.50
VOICE_JAX_TIMEOUT_SECS=300

# A latency budget, not a capability wish list. Every server named here starts
# before the model answers a word: none 4s, four 7s, fifteen never returned.
VOICE_JAX_MCP_SERVERS=memory,github

# Carry one session across a conversation, so a follow-up knows what the
# previous turn was about. Also about six times faster after the first question.
VOICE_JAX_STICKY_SESSION=1

# Where the install lives - the directory holding .mcp.json. Auto-detected by
# walking up from this plugin; set it if that guess is wrong.
# VOICE_REPO_ROOT=

# --- delivery ---------------------------------------------------------------

# Chat channel for escalation answers, so walking away mid-answer does not lose
# one. Empty means spoken-only.
VOICE_ANSWER_CHANNEL_ID=

# Operational noise only. Falls back to the answer channel when unset.
VOICE_DEVOPS_CHANNEL_ID=

# --- serving ----------------------------------------------------------------

VOICE_PORT=7860
# 0 skips tailscale and serves on localhost only. The right setting for a
# laptop, and for anyone who would rather not publish a microphone-adjacent
# endpoint onto a network.
VOICE_SERVE_HTTPS_PORT=8443
VOICE_OLLAMA_URL=http://127.0.0.1:11434

# --- read-back gate ---------------------------------------------------------

# Reads an escalation back before it runs and waits for a yes. Off by default:
# its privacy half became redundant when the keyword net started refusing
# outright, and a read-back on every escalated turn is a lot of friction for a
# thing whose whole point is speed. Turn it on if you would rather hear a
# misheard sentence before it starts an agent.
VOICE_CONFIRM_JAX=0
